# strands-agents-runtime が参照する環境変数の一覧（値はすべて例）。
#
# ランタイム自身は .env を読みません。次のいずれかで子プロセスに渡してください。
#   uv run --env-file .env strands-runtime serve
#   docker run --env-file .env ...
# AgentCore 上では Runtime の environmentVariables（CDK / CLI）で同じ名前を設定します。
# 原則: 設定ファイル（runtime.toml / agent.toml）は「何を動かすか」、環境変数は
# 「どこで・誰の資格で動かすか」とシークレット。TOML 側は ${VAR} / ${VAR:-default} で変数名だけを参照します。

# ---------------------------------------------------------------------------
# ランタイム
# ---------------------------------------------------------------------------
# runtime.toml の場所（既定: ./runtime.toml）
#STRANDS_RUNTIME_CONFIG=./runtime.toml
# 公開するエージェントをカンマ区切りで上書き（[runtime] enabled_agents より優先）。
# 同じイメージから複数の Runtime を作るときに使う。
#STRANDS_RUNTIME_ENABLED_AGENTS=assistant,researcher

# ---------------------------------------------------------------------------
# モデルプロバイダーのシークレットと接続先
#   agent.toml の [model] api_key_env で名指しした変数を読む。既定は OPENAI_API_KEY。
# ---------------------------------------------------------------------------
# OpenRouter（examples と agents/assistant が使用）
OPENROUTER_API_KEY=
# OpenAI 本家（openai/ および api_key_env 未指定の openai-chat/）
#OPENAI_API_KEY=
# openai-chat/ で [model] base_url を省いたときのフォールバック（通常は TOML に base_url を書く）
#OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic（anthropic/、extras: anthropic）
#ANTHROPIC_API_KEY=
# Google Gemini（google/、extras: gemini）
#GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# AWS（bedrock/ モデル、[session] backend = "s3" / "agentcore_memory"）
#   AgentCore 上では実行ロールが使われるため不要。ローカルでは資格情報プロバイダーチェーンに従う。
# ---------------------------------------------------------------------------
#AWS_REGION=us-west-2
#AWS_PROFILE=default
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
#AWS_SESSION_TOKEN=

# ---------------------------------------------------------------------------
# TOML から ${VAR} で参照する、プロジェクト固有の値（例）
# ---------------------------------------------------------------------------
# runtime.toml: default_id = "${RUNTIME_DEFAULT_MODEL:-...}"
#RUNTIME_DEFAULT_MODEL=openai-chat/deepseek/deepseek-v4.1-flash-1017
# [session] bucket = "${SESSION_BUCKET}" / memory_id = "${AGENTCORE_MEMORY_ID}" のように使う
#SESSION_BUCKET=
#AGENTCORE_MEMORY_ID=
# MCP サーバーのヘッダー: headers = { Authorization = "Bearer ${DOCS_MCP_TOKEN}" }
#DOCS_MCP_TOKEN=

# ---------------------------------------------------------------------------
# 観測性（OpenTelemetry 標準。ランタイムは TOML では扱わない）
#   ローカル: 未設定ならトレースを送らない。Docker でコレクターがないときは OTEL_SDK_DISABLED=true。
#   AgentCore: Runtime が ADOT 用の値を注入するので設定しない。
# ---------------------------------------------------------------------------
#OTEL_SDK_DISABLED=true
#OTEL_TRACES_EXPORTER=otlp            # otlp | console | none（カンマ区切り可）
#OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
#OTEL_EXPORTER_OTLP_HEADERS=
#OTEL_SERVICE_NAME=strands-runtime
#OTEL_RESOURCE_ATTRIBUTES=deployment.environment=dev

# ---------------------------------------------------------------------------
# コンテナ
# ---------------------------------------------------------------------------
# 設定されていると 0.0.0.0 にバインドする（Dockerfile が設定済み。手動で起動する場合のみ）
#DOCKER_CONTAINER=1
